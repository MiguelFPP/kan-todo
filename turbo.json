{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "prisma:generate": {
      "outputs": ["node_modules/.prisma/client/**"]
    },
    "prisma:push": {
      "cache": false
    },
    "prisma:migrate": {
      "cache": false
    },
    "prisma:studio": {
      "cache": false,
      "persistent": true
    },
    "prisma:reset": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
